generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// --- ENUMS NATIVOS DO POSTGRESQL ---
// ==========================================
enum PapelMembro {
  ADMIN
  INSTRUTOR
  ALUNO
}

enum StatusSolicitacao {
  PENDENTE
  ACEITO
  RECUSADO
}

// ==========================================
// --- TABELAS EXISTENTES ATUALIZADAS ---
// ==========================================

model Usuario {
  id               Int                  @id @default(autoincrement())
  nome             String
  email            String               @unique
  senha            String
  role             String               @default("mesario") 
  email_verificado Boolean              @default(false)
  created_at       DateTime             @default(now())

  // Relações com as novas tabelas
  dojos_criados         Dojo[]               @relation("DojosCriados")
  membros_dojo          MembroDojo[]
  vinculos_responsaveis VinculoResponsavel[]

  @@map("usuarios")
}

model Atleta {
  id                Int                  @id @default(autoincrement())
  nome              String
  data_nascimento   DateTime?
  sexo              String?
  peso              Float?
  faixa             String?
  created_at        DateTime             @default(now())
  
  pontuacoes_kata   PontuacaoKata[]
  pontuacoes_kumite PontuacaoKumite[]
  vinculos_responsaveis VinculoResponsavel[]

  @@map("atletas")
}

model Evento {
  id                Int                  @id @default(autoincrement())
  nome              String
  tipo              String?
  data              DateTime
  local             String?
  observacoes       String?
  created_at        DateTime             @default(now())
  
  pontuacoes_kata   PontuacaoKata[]
  pontuacoes_kumite PontuacaoKumite[]

  @@map("eventos")
}

model PontuacaoKata {
  id            Int      @id @default(autoincrement())
  atleta_id     Int
  evento_id     Int?
  data          DateTime
  nome_kata     String
  nota_tecnica  Float    @default(0)
  nota_atletica Float    @default(0)
  nota_final    Float    @default(0)
  resultado     String?
  observacoes   String?
  created_at    DateTime @default(now())

  atleta Atleta  @relation(fields: [atleta_id], references: [id], onDelete: Cascade)
  evento Evento? @relation(fields: [evento_id], references: [id], onDelete: Cascade)

  @@map("pontuacoes_kata")
}

model PontuacaoKumite {
  id              Int      @id @default(autoincrement())
  atleta_id       Int
  evento_id       Int?
  data            DateTime
  adversario_nome String?
  ippon           Int      @default(0)
  waza_ari        Int      @default(0)
  yuko            Int      @default(0)
  pontos_sofridos Int      @default(0)
  pontos_totais   Int      @default(0)
  resultado       String?
  observacoes     String?
  created_at      DateTime @default(now())

  atleta Atleta  @relation(fields: [atleta_id], references: [id], onDelete: Cascade)
  evento Evento? @relation(fields: [evento_id], references: [id], onDelete: Cascade)

  @@map("pontuacoes_kumite")
}

// ==========================================
// --- NOVAS TABELAS: GESTÃO E DOJOS ---
// ==========================================

model Dojo {
  id           Int          @id @default(autoincrement())
  nome         String
  logo_url     String?
  criador_id   Int
  data_criacao DateTime     @default(now())

  criador      Usuario      @relation("DojosCriados", fields: [criador_id], references: [id], onDelete: Cascade)
  membros      MembroDojo[]

  @@map("dojos")
}

model MembroDojo {
  id               Int               @id @default(autoincrement())
  dojo_id          Int
  usuario_id       Int
  papel            PapelMembro       @default(ALUNO)
  status           StatusSolicitacao @default(PENDENTE)
  data_solicitacao DateTime          @default(now())

  dojo             Dojo              @relation(fields: [dojo_id], references: [id], onDelete: Cascade)
  usuario          Usuario           @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@unique([dojo_id, usuario_id])
  @@map("membros_dojo")
}

model VinculoResponsavel {
  id             Int      @id @default(autoincrement())
  atleta_id      Int
  responsavel_id Int
  parentesco     String?
  data_vinculo   DateTime @default(now())

  atleta         Atleta   @relation(fields: [atleta_id], references: [id], onDelete: Cascade)
  responsavel    Usuario  @relation(fields: [responsavel_id], references: [id], onDelete: Cascade)

  @@unique([atleta_id, responsavel_id])
  @@map("vinculos_responsaveis")
}